    "strings": [
      {
        "start": 16,
        "end": 52,
        "byte_length": 36,
        "text": "疲れ切っているリフィアを休ませるため"
      },
      {
        "start": 80,
        "end": 120,
        "byte_length": 40,
        "text": "レテアの森の南東にあるトパジオンを目指す"
      },
      {
        "start": 160,
        "end": 198,
        "byte_length": 38,
        "text": "リフィアを休ませるため、宿を探すラルク"
      },
      {
        "start": 304,
        "end": 342,
        "byte_length": 38,
        "text": "リフィアが休んでいる間、アルスの頼みで"
      },
      {
        "start": 368,
        "end": 406,
        "byte_length": 38,
        "text": "村長に濁竜被害について聞きに行くラルク"
      },
      {
        "start": 433,
        "end": 436,
        "byte_length": 3,
        "text": "\u000f紅"
      },
      {
        "start": 448,
        "end": 472,
        "byte_length": 24,
        "text": "村長の話を聞いたラルクは"
      },
      {
        "start": 512,
        "end": 542,
        "byte_length": 30,
        "text": "アルスと合流するため宿へ向かう"
      },
      {
        "start": 592,
        "end": 628,
        "byte_length": 36,
        "text": "ジャダへ行きたいというリフィアを連れ"
      },
      {
        "start": 656,
        "end": 690,
        "byte_length": 34,
        "text": "トパジオンの南にあるジャダを目指す"
      },
      {
        "start": 736,
        "end": 764,
        "byte_length": 28,
        "text": "アルスの提案で、ラルクたちは"
      },
      {
        "start": 800,
        "end": 836,
        "byte_length": 36,
        "text": "ジャダの司令官、クライドに会いに行く"
      },
      {
        "start": 865,
        "end": 868,
        "byte_length": 3,
        "text": "\u000f獰"
      },
      {
        "start": 880,
        "end": 908,
        "byte_length": 28,
        "text": "ジャダが何者かに襲撃された。"
      },
      {
        "start": 944,
        "end": 976,
        "byte_length": 32,
        "text": "敵を倒しつつ、街の入り口へ向かう"
      }
    ]
  },
  "help.bin": {
    "path": "C:\\Users\\CadriacLord\\Documents\\Codex\\2026-08-03\\f-down-arc-rise-fantasia-japan\\work\\disc_extracted\\DATA\\files\\Sys\\help.bin",
    "size": 131860,
    "head_hex": "b9 d4 c6 b0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 a5 ad a5 e3 a5 e9 a5 af a5 bf a1 bc a4 ac c0 ef c6 ae c3 e6 a4 cb 0a bc c2 b9 d4 a4 c7 a4 ad a4 eb c1 b4 a4 c6 a4 ce c1 aa c2 f2",
