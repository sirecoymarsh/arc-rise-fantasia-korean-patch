    "strings": [
      {
        "start": 3,
        "end": 10,
        "byte_length": 7,
        "text": "\u001eガーヌ"
      },
      {
        "start": 20,
        "end": 56,
        "byte_length": 36,
        "text": "足は遅いけど根性だけなら負けないです"
      },
      {
        "start": 160,
        "end": 166,
        "byte_length": 6,
        "text": "イサヤ"
      },
      {
        "start": 176,
        "end": 237,
        "byte_length": 61,
        "text": "昨日からおなかが痛いのです。\nトゲトゲしたものを丸呑みしました"
      },
      {
        "start": 309,
        "end": 322,
        "byte_length": 13,
        "text": "\u0004\u0002\u0005\u0001\u0004\u0002\u0003イート"
      },
      {
        "start": 332,
        "end": 379,
        "byte_length": 47,
        "text": "巨大な生物に食べられる夢を見ました……\n不安です"
      },
      {
        "start": 464,
        "end": 478,
        "byte_length": 14,
        "text": "\u0001\u0004\u0002\u0004\u0002\u0004\u0003\u0002マッキ"
      },
      {
        "start": 488,
        "end": 520,
        "byte_length": 32,
        "text": "ウマナミと呼ばれたことがあります"
      },
      {
        "start": 617,
        "end": 636,
        "byte_length": 19,
        "text": "\u0003d\u0002\u0001\u0004\u0003\u0004\u0003\u0004\u0002\u0003アクター"
      },
      {
        "start": 644,
        "end": 676,
        "byte_length": 32,
        "text": "がんばれないことはないと思います"
      },
      {
        "start": 774,
        "end": 792,
        "byte_length": 18,
        "text": "i\u0001\u0003\u0005\u0004\u0005\u0001\u0004\u0004\u0003カーシュ"
      },
      {
        "start": 800,
        "end": 830,
        "byte_length": 30,
        "text": "僕はまだまだ進化の途中なのです"
      },
      {
        "start": 928,
        "end": 948,
        "byte_length": 20,
        "text": "\u0003\u0005n\u0002\u0003\u0001\u0005\u0003\u0004\u0004\u0003\u0004ウッディ"
      },
      {
        "start": 956,
        "end": 974,
        "byte_length": 18,
        "text": "前ニ出ルヤツ　食ウ"
      },
      {
        "start": 1092,
        "end": 1102,
        "byte_length": 10,
        "text": "\u0001\u0004\u0004\u0003メイマ"
      },
      {
        "start": 1112,
        "end": 1157,
        "byte_length": 45,
        "text": "個性がないとよく言われます……\nグサリときます"
      },
      {
        "start": 1240,
        "end": 1258,
        "byte_length": 18,
        "text": "\u0002\u0007U\u0004\u0002\u0004\u0005\u0006\u0002\u0004\u0002\u0003カミル"
      },
      {
        "start": 1268,
        "end": 1294,
        "byte_length": 26,
        "text": "気がついたらここにいました"
      },
      {
        "start": 1403,
        "end": 1414,
        "byte_length": 11,
        "text": "\u0005\u0003\u0002\u0001\u0001ラヴィ"
      },
      {
        "start": 1424,
        "end": 1448,
        "byte_length": 24,
        "text": "あの子のことを思うと……"
      },
      {
        "start": 1554,
        "end": 1570,
        "byte_length": 16,
        "text": "_\u0005\u0002\u0004\u0002\u0004\u0004\u0004\u0002\u0002ミック"
      },
      {
        "start": 1580,
        "end": 1608,
        "byte_length": 28,
        "text": "今まで負けたことはありません"
      },
      {
        "start": 1717,
        "end": 1726,
        "byte_length": 9,
        "text": "\u0004\u0003\u0003マーノ"
      },
      {
        "start": 1736,
        "end": 1760,
        "byte_length": 24,
        "text": "賭け金次第でがんばります"
      },
      {
        "start": 1868,
        "end": 1884,
        "byte_length": 16,
        "text": "\u0002\u0004\u0005\u0005\u0002\u0004\u0003\u0003ゴエモン"
      },
      {
        "start": 1892,
        "end": 1920,
        "byte_length": 28,
        "text": "燃やすのは良くないと思います"
      },
      {
        "start": 2020,
        "end": 2040,
        "byte_length": 20,
        "text": "\u0003\u0006n\u0001\u0003\u0004\u0004\u0004\u0004\u0004\u0002\u0001ヨシュア"
      },
      {
        "start": 2048,
        "end": 2068,
        "byte_length": 20,
        "text": "なにかが刺さってます"
      },
      {
        "start": 2182,
        "end": 2194,
        "byte_length": 12,
        "text": "\u0004\u0006\u0005\u0004\u0004\u0003イタチ"
      },
      {
        "start": 2204,
        "end": 2232,
        "byte_length": 28,
        "text": "究極のモンスターになりました"
      },
      {
        "start": 2341,
        "end": 2350,
        "byte_length": 9,
        "text": "\u0004\u0002\u0002コネカ"
      },
      {
        "start": 2360,
        "end": 2384,
        "byte_length": 24,
        "text": "帰って一杯やりたいのです"
      },
      {
        "start": 2497,
        "end": 2506,
        "byte_length": 9,
        "text": "\u0004\u0001\u0003リズム"
      },
      {
        "start": 2516,
        "end": 2544,
        "byte_length": 28,
        "text": "昨日の夕食はなべ底大根でした"
      },
      {
        "start": 2645,
        "end": 2662,
        "byte_length": 17,
        "text": "\u0007_\u0005\u0001\u0004\u0002\u0004\u0002\u0004\u0001\u0001カンキ"
      },
      {
        "start": 2672,
        "end": 2704,
        "byte_length": 32,
        "text": "友人があんなことになるなんて……"
      },
      {
        "start": 2800,
        "end": 2818,
        "byte_length": 18,
        "text": "\u0001\u0007d\u0003\u0002\u0004\u0003\u0002\u0002\u0004\u0002\u0003フック"
      },
      {
        "start": 2828,
        "end": 2856,
        "byte_length": 28,
        "text": "ボクって酸に弱かったんですね"
      },
      {
        "start": 2957,
        "end": 2974,
        "byte_length": 17,
        "text": "\bi\u0005\u0002\u0004\u0004\u0001\u0004\u0004\u0002\u0003カブト"
      },
      {
        "start": 2984,
        "end": 3022,
        "byte_length": 38,
        "text": "僕の前には何人たりとも走らせないのです"
      },
      {
        "start": 3121,
        "end": 3130,
        "byte_length": 9,
        "text": "\u0004\u0003\u0003ルーツ"
      },
      {
        "start": 3140,
        "end": 3185,
        "byte_length": 45,
        "text": "視線が気になって眠れません。\nこれで３日目です"
      },
      {
        "start": 3277,
        "end": 3288,
        "byte_length": 11,
        "text": "\u0004\u0003\u0004マイケル"
      },
      {
        "start": 3296,
        "end": 3347,
        "byte_length": 51,
        "text": "はじめに言っておきますが\nボクはおいしくないですよ？"
      },
      {
        "start": 3424,
        "end": 3444,
        "byte_length": 20,
        "text": "\u0001\u0004U\u0001\u0002\u0004\u0003\u0002\u0001\u0004\u0001\u0003タッフィ"
      },
      {
        "start": 3452,
        "end": 3488,
        "byte_length": 36,
        "text": "飲んだあとは出ないほうがいいですよね"
      },
      {
        "start": 3580,
        "end": 3598,
        "byte_length": 18,
        "text": "\u0002\u0002Z\u0001\u0001\u0004\u0002\u0002\u0002\u0004\u0001\u0003ゴロー"
      },
      {
        "start": 3608,
        "end": 3667,
        "byte_length": 59,
        "text": "今日はホームランを打ちます。\nやったね、今日はすき焼きだね！"
      },
      {
        "start": 3736,
        "end": 3754,
        "byte_length": 18,
        "text": "\u0003\u0003_\u0002\u0001\u0004\u0002\u0003\u0003\u0004\u0001\u0004フォル"
      },
      {
        "start": 3764,
        "end": 3794,
        "byte_length": 30,
        "text": "今日のゴハンがかかってるんです"
      },
      {
        "start": 3892,
        "end": 3914,
        "byte_length": 22,
        "text": "\u0003\u0004d\u0002\u0002\u0004\u0003\u0003\u0003\u0004\u0002\u0003ゴンザレス"
      },
      {
        "start": 3920,
        "end": 3942,
        "byte_length": 22,
        "text": "ワタシ　ハヤイ　アルネ"
      },
      {
        "start": 4057,
        "end": 4068,
        "byte_length": 11,
        "text": "\u0004\u0002\u0001ナンミー"
      },
      {
        "start": 4076,
        "end": 4137,
        "byte_length": 61,
        "text": "小さいころからの疑問なのですが\n僕らに戸籍はあるんでしょうか？"
      },
      {
        "start": 4208,
        "end": 4220,
        "byte_length": 12,
        "text": "\u0003\u0001\u0004\u0005\u0002\u0004\u0003\u0003ギシ"
      },
      {
        "start": 4232,
        "end": 4270,
        "byte_length": 38,
        "text": "書類にハンコを押しただけなのですが……"
      },
      {
        "start": 4369,
        "end": 4384,
        "byte_length": 15,
        "text": "\u0004\u0003\u0003ブルーキング"
      },
      {
        "start": 4388,
        "end": 4414,
        "byte_length": 26,
        "text": "大事なものを失った気が……"
      },
      {
        "start": 4516,
        "end": 4538,
        "byte_length": 22,
        "text": "\u0001\u0002U\u0004\u0001\u0004\u0005\u0003\u0003\u0004\u0002\u0003オーフィー"
      },
      {
        "start": 4544,
        "end": 4566,
        "byte_length": 22,
        "text": "ご主人がすぐ怒るんです"
      }
    ]
  }
